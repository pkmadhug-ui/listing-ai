# Google AI Studio se free key lo: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low = fast (default). Listing ki quality kam lage toh medium karo. off = setting band.
GEMINI_THINKING=low
# Ek saath kitni AI calls (free tier pe 2 safe hai). Paid billing ho toh 4 kar sakte ho.
GEMINI_PARALLEL=2
# Ek AI call ka max time (seconds)
GEMINI_TIMEOUT=60
